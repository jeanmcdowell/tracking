{
  "name": "tracking",
  "version": "1.0.0",
  "description": "A comprehensive energy and resource tracking application",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "vite build",
    "dev": "vite"
  },
  "devDependencies": {
    "typescript": "^5",
    "eslint": "^9",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint-config-prettier": "^9",
    "prettier": "^3",
    "vitest": "^2",
    "jsdom": "^26",
    "@vitest/coverage-v8": "^2",
    "vite": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18"
  }
}
